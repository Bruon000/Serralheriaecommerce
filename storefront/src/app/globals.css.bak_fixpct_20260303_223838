/* ===========================
   DEV Layout Tuner (runtime)
   Ativa somente quando <html data-dev-tune="1">
   =========================== */

html[data-dev-tune="1"] .dev-cols-layout {
  gap: var(--devColsGap, 16px) !important;
}

html[data-dev-tune="1"] .dev-cols-layout {
  grid-template-columns: repeat(var(--devColsBase, 1), minmax(0, 1fr)) !important;
}

@media (min-width: 1024px) {
  html[data-dev-tune="1"] .dev-cols-layout {
    grid-template-columns: repeat(var(--devColsLg, 2), minmax(0, 1fr)) !important;
  }
}

@media (min-width: 1280px) {
  html[data-dev-tune="1"] .dev-cols-layout {
    grid-template-columns: repeat(var(--devColsXl, 2), minmax(0, 1fr)) !important;
  }
}

html[data-dev-tune="1"] .dev-product-header-card {
  padding: var(--devProductHeaderPad, 16px) !important;
}

html[data-dev-tune="1"] .dev-product-title {
  font-size: var(--devProductTitleSize, 30px) !important;
  line-height: 1.1 !important;
}

/* ===========================
   AJUSTES RÁPIDOS (runtime)
   Ativa somente quando <html data-dev-tune="1">
   =========================== */

html[data-dev-tune="1"] .dev-cols-layout {
  gap: var(--devColsGap, 16px) !important;
  padding-left: var(--devColsPadX, 16px) !important;
  padding-right: var(--devColsPadX, 16px) !important;
  max-width: var(--devColsMaxW, 1320px) !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

html[data-dev-tune="1"] .dev-cols-layout {
  grid-template-columns: repeat(var(--devColsBase, 1), minmax(0, 1fr)) !important;
}

