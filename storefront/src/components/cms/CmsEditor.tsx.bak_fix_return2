"use client";

import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import type { CmsBlock, CmsPageContent } from "@/lib/cms/types";
import { createBlock } from "@/lib/cms/types";
import BlockList from "./BlockList";
import BlockPropsPanel from "./BlockPropsPanel";
import CmsEditorHelp from "./CmsEditorHelp";
import type { CmsDraftMessage } from "./CmsPreviewReceiver";

type PageRow = {
  id: string;
  urlPath: string;
  title: string | null;
  contentJson: string | null;
  publishedContentJson?: string | null;
  published: boolean;
  routeParamsExample?: string | null;
  updatedAt: string;
};

type SiteRoute = {
  path: string;
  label: string;
  dynamic?: boolean;
  paramExample?: string;
};

type Props = {
  initialPages: PageRow[];
};

function getPreviewUrl(urlPath: string, routeParamsExample: string | null | undefined): string {
  let path = urlPath || "/";
  if (path.includes("[") && routeParamsExample) {
    try {
      const params = JSON.parse(routeParamsExample) as Record<string, string>;
      for (const [key, value] of Object.entries(params)) {
        path = path.replace(`[${key}]`, value ?? "");
      }
    } catch {
      path = path.replace("[handle]", "exemplo");
    }
  }
  const sep = path.includes("?") ? "&" : "?";
  return `${path}${sep}cmsPreview=1`;
}

export default function CmsEditor({ initialPages }: Props) {
  const [pages, setPages] = useState<PageRow[]>(initialPages);
  const [siteRoutes, setSiteRoutes] = useState<SiteRoute[]>([]);
  const [urlPath, setUrlPath] = useState("/");
  const [title, setTitle] = useState("");
  const [routeParamsExample, setRouteParamsExample] = useState("");

  const [blocks, setBlocks] = useState<CmsBlock[]>([]);
  const [selectedBlockId, setSelectedBlockId] = useState<string | null>(null);

  const [published, setPublished] = useState(false);
  const [pageId, setPageId] = useState<string | null>(null);

  const [toast, setToast] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);

  const [autosave, setAutosave] = useState(false);
  const autosaveSeconds = 2;

  const iframeRef = useRef<HTMLIFrameElement>(null);

  const previewUrl = useMemo(() => getPreviewUrl(urlPath, routeParamsExample || null), [urlPath, routeParamsExample]);

  const selectedBlock = useMemo(
    () => blocks.find((b) => b.id === selectedBlockId) ?? null,
    [blocks, selectedBlockId]
  );

  const loadSiteRoutes = useCallback(async () => {
    try {
      const res = await fetch("/api/cms/site-routes");
      if (res.ok) {
        const data = await res.json();
        if (data.routes) setSiteRoutes(data.routes);
      }
    } catch {
      // silencioso
    }
  }, []);

  const loadPagesList = useCallback(async () => {
    try {
      const listRes = await fetch("/api/cms/pages");
      if (listRes.status === 401) {
        window.location.href = "/admin/login";
        return;
      }
      const listData = await listRes.json().catch(() => ({}));
      if (listData.pages) setPages(listData.pages);
    } catch {
      // silencioso
    }
  }, []);

  const loadPage = useCallback(async (path: string) => {
    setError(null);

    try {
      const res = await fetch(`/api/cms/page?urlPath=${encodeURIComponent(path)}`);

      if (res.status === 401) {
        window.location.href = "/admin/login";
        return;
      }

      if (res.status === 404) {
        setPageId(null);
        setTitle("");
        setBlocks([]);
        setPublished(false);
        setRouteParamsExample("");
        setSelectedBlockId(null);
        return;
      }

      const data = await res.json().catch(() => ({}));
      if (!data.ok || !data.page) return;

      const p = data.page as PageRow;

      setPageId(p.id);
      setTitle(p.title ?? "");
      setPublished(Boolean(p.published));
      setRouteParamsExample(
        typeof p.routeParamsExample === "string" ? p.routeParamsExample : p.routeParamsExample ? JSON.stringify(p.routeParamsExample) : ""
      );
      setSelectedBlockId(null);

      try {
        const content = p.contentJson ? (JSON.parse(p.contentJson) as CmsPageContent) : null;
        setBlocks(content?.blocks ?? []);
      } catch {
        setBlocks([]);
      }
    } catch {
      setError("Erro ao carregar página");
      setBlocks([]);
    }
  }, []);

  useEffect(() => {
    loadSiteRoutes();
  }, [loadSiteRoutes]);

  useEffect(() => {
    loadPage(urlPath);
  }, [urlPath, loadPage]);

  // Enviar draft para o iframe (preview ao vivo)
  useEffect(() => {
    const win = iframeRef.current?.contentWindow;
    if (!win || !urlPath.startsWith("/")) return;

    const message: CmsDraftMessage = {
      type: "CMS_DRAFT",
      urlPath,
      contentJson: JSON.stringify({ blocks }),
    };
    win.postMessage(message, "*");
  }, [urlPath, blocks]);

  const addBlock = useCallback((type: CmsBlock["type"]) => {
    const newBlock = createBlock(type);
    setBlocks((prev) => [...prev, newBlock]);
    setSelectedBlockId(newBlock.id);
  }, []);

  const updateBlock = useCallback((updated: CmsBlock) => {
    setBlocks((prev) => prev.map((b) => (b.id === updated.id ? updated : b)));
  }, []);

  const save = useCallback(async () => {
    setError(null);

    if (!urlPath.startsWith("/")) {
      setError("urlPath deve começar com /");
      return;
    }

    const contentJson = JSON.stringify({ blocks });

    try {
      const body: Record<string, unknown> = {
        urlPath,
        title: title || null,
        contentJson,
      };
      let rpe = null;
      if (routeParamsExample.trim()) {
        try {
          JSON.parse(routeParamsExample);
          rpe = routeParamsExample.trim();
        } catch {
          setError("routeParamsExample deve ser JSON válido (ex: {\"handle\": \"meu-produto\"})");
          return;
        }
        body.routeParamsExample = rpe;
      }

      const res = await fetch("/api/cms/pages", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        setError((data.error as string) ?? "Erro ao salvar");
        return;
      }

      setPageId(data.page?.id ?? pageId);

      setToast("Salvo!");
      window.setTimeout(() => setToast(null), 2000);

      await loadPagesList();
    } catch {
      setError("Erro ao salvar");
    }
  }, [urlPath, title, routeParamsExample, blocks, pageId, loadPagesList]);

  const publish = useCallback(async () => {
    setError(null);
    try {
      const contentJson = JSON.stringify({ blocks });
      const res = await fetch("/api/cms/pages", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ urlPath, published: true, contentJson }),
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        setError((data.error as string) ?? "Erro ao publicar");
        return;
      }

      setPublished(true);
      setToast("Publicado!");
      window.setTimeout(() => setToast(null), 2000);

      await loadPagesList();
    } catch {
      setError("Erro ao publicar");
    }
  }, [urlPath, blocks, loadPagesList]);

  useEffect(() => {
    if (!autosave) return;
    const t = setInterval(() => {
      if (!urlPath.startsWith("/")) return;
      save();
    }, autosaveSeconds * 1000);

    return () => clearInterval(t);
  }, [autosave, autosaveSeconds, save, urlPath]);
  // Receber seleção vinda do iframe (clicou no bloco no preview)
  useEffect(() => {
    function onMsg(event: MessageEvent) {
      const data: any = event.data;
      if (!data || data.type !== "CMS_SELECT") return;
      if (data.urlPath !== urlPath) return;
      if (typeof data.blockId === "string") {
        setSelectedBlockId(data.blockId);
      }
    }
    window.addEventListener("message", onMsg);
    return () => window.removeEventListener("message", onMsg);
  }, [urlPath]);
  const isDynamicRoute = urlPath.includes("[");
    <div className="grid gap-6 lg:grid-cols-[280px_1fr_340px]">
      {/* Coluna esquerda: páginas + blocos */}
      <div className="space-y-4">
        <CmsEditorHelp />

        <div className="steel-card p-4">
          <div className="text-sm font-extrabold text-foreground/90 mb-3">Páginas do site</div>

          <div className="grid gap-2">
            <label className="text-xs text-muted-foreground">Rotas do site</label>
            <div className="flex flex-wrap gap-1">
              {siteRoutes.map((r) => (
                <button
                  key={r.path}
                  type="button"
                  onClick={() => setUrlPath(r.path)}
                  className={`rounded-full border px-3 py-1.5 text-xs font-medium transition ${
                    urlPath === r.path
                      ? "border-primary bg-primary/20 text-primary-foreground"
                      : "border-border/50 bg-black/25 hover:bg-black/40"
                  }`}
                >
                  {r.label}
                </button>
              ))}
            </div>

            <label className="text-xs text-muted-foreground mt-2">Ou carregar página existente</label>
            <select
              className="h-10 w-full rounded-xl border border-border/50 bg-black/35 px-3 text-sm"
              value={urlPath}
              onChange={(e) => {
                const v = e.target.value;
                if (v) setUrlPath(v);
              }}
            >
              <option value="">— escolher —</option>
              {pages.map((p) => (
                <option key={p.id} value={p.urlPath}>
                  {p.urlPath} {p.published ? "✓" : ""}
                </option>
              ))}
            </select>

            <label className="text-xs text-muted-foreground">URL (urlPath)</label>
            <input
              className="h-10 w-full rounded-xl border border-border/50 bg-black/35 px-3 text-sm"
              value={urlPath}
              onChange={(e) => setUrlPath(e.target.value)}
              placeholder="/minha-pagina"
            />

            {isDynamicRoute && (
              <>
                <label className="text-xs text-muted-foreground">Exemplo de parâmetros (JSON)</label>
                <input
                  className="h-10 w-full rounded-xl border border-border/50 bg-black/35 px-3 text-sm font-mono text-xs"
                  value={routeParamsExample}
                  onChange={(e) => setRouteParamsExample(e.target.value)}
                  placeholder='{"handle": "portao-basculante"}'
                />
              </>
            )}

            <label className="text-xs text-muted-foreground">Título (opcional)</label>
            <input
              className="h-10 w-full rounded-xl border border-border/50 bg-black/35 px-3 text-sm"
              value={title}
              onChange={(e) => setTitle(e.target.value)}
              placeholder="Título da página"
            />

            {urlPath !== "/" && (
              <button
                type="button"
                onClick={() => setUrlPath("/")}
                className="text-xs font-medium text-primary hover:underline"
              >
                ← Criar/Editar Home
              </button>
            )}
          </div>
        </div>

        <div className="steel-card p-4">
          <BlockList
            blocks={blocks}
            selectedId={selectedBlockId}
            onBlocksChange={setBlocks}
            onSelectBlock={setSelectedBlockId}
            onAddBlock={addBlock}
          />
        </div>
      </div>

      {/* Centro: iframe preview real */}
      <div className="flex flex-col gap-4 min-h-0">
        <div className="steel-card p-4 flex flex-wrap items-center justify-between gap-3">
          <span className="text-sm font-extrabold text-foreground/90">Preview ao vivo</span>

          <div className="flex flex-wrap items-center gap-2">
            <a
              href={previewUrl}
              target="_blank"
              rel="noreferrer"
              className="inline-flex items-center rounded-full border border-border/60 bg-black/25 px-4 py-2 text-xs font-extrabold hover:bg-black/40"
            >
              Abrir em nova aba
            </a>

            <button
              type="button"
              onClick={save}
              className="inline-flex items-center rounded-full bg-primary px-4 py-2 text-xs font-extrabold text-primary-foreground hover:brightness-110"
            >
              Salvar
            </button>

            {!published ? (
              <button
                type="button"
                onClick={publish}
                className="inline-flex items-center rounded-full border border-primary/60 bg-primary/20 px-4 py-2 text-xs font-extrabold text-primary-foreground/90 hover:bg-primary/30"
              >
                Publicar
              </button>
            ) : (
              <span className="rounded-full bg-green-500/20 px-3 py-1 text-xs font-extrabold text-green-400">
                Publicado
              </span>
            )}

            <label className="flex items-center gap-2 text-xs text-muted-foreground">
              <input
                type="checkbox"
                checked={autosave}
                onChange={(e) => setAutosave(e.target.checked)}
              />
              Autosave ({autosaveSeconds}s)
            </label>
          </div>
        </div>

        <div className="steel-card flex-1 min-h-[420px] overflow-hidden flex flex-col">
          <iframe
            ref={iframeRef}
            src={previewUrl}
            title="Preview da página"
            className="w-full flex-1 min-h-[400px] border-0 rounded-xl bg-background"
            sandbox="allow-same-origin allow-scripts"
          />
        </div>

        {error && (
          <div className="rounded-xl border border-red-500/50 bg-red-500/10 px-4 py-2 text-sm text-red-300">
            {error}
          </div>
        )}
      </div>

      {/* Direita: propriedades + help do bloco */}
      <div className="min-h-0">
        <BlockPropsPanel block={selectedBlock} onChange={updateBlock} />
      </div>

      {toast && (
        <div className="fixed bottom-6 right-6 rounded-xl bg-primary/90 px-4 py-2 text-sm font-extrabold text-primary-foreground shadow-lg">
          {toast}
        </div>
      )}
    </div>
  );
}



