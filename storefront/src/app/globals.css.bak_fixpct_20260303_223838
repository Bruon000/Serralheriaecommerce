@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* Tema modernized (Delima) - HSL para Tailwind */
    --background: 25 12% 6%;
    --foreground: 42 30% 90%;
    --card: 25 10% 10%;
    --card-foreground: 42 30% 90%;
    --primary: 38 85% 50%;
    --primary-foreground: 25 20% 8%;
    --secondary: 25 8% 15%;
    --secondary-foreground: 42 20% 78%;
    --muted: 25 8% 13%;
    --muted-foreground: 35 12% 50%;
    --accent: 30 80% 45%;
    --accent-foreground: 25 20% 8%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 210 40% 98%;
    --border: 30 18% 16%;
    --input: 30 18% 16%;
    --ring: 38 85% 50%;
    --radius: 0.75rem;
    --gold: 38 85% 50%;
    --gold-light: 42 90% 65%;
    --gold-dark: 30 80% 38%;
    /* ThemeAutoStyle / legacy */
    --theme-accent: #c97a0f;
    --theme-bg: hsl(25 12% 6%);
    --theme-fg: hsl(42 30% 90%);
    --theme-banner-text: "";
    --shadow: 0 8px 24px rgba(0,0,0,.3);
    --shadowHover: 0 14px 34px rgba(0,0,0,.4);
  }
  body {
  background-image:
    radial-gradient(circle at 18% 12%, rgba(245, 158, 11, 0.16), transparent 46%),
    radial-gradient(circle at 82% 58%, rgba(220, 38, 38, 0.10), transparent 50%);
  background-attachment: fixed;
    @apply bg-background text-foreground antialiased;
    font-family: var(--font-inter), 'Inter', ui-sans-serif, system-ui, sans-serif;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-space-grotesk), 'Space Grotesk', sans-serif;
  }
}

@layer utilities {
  .text-gradient-gold {
    background: linear-gradient(135deg, hsl(42 100% 62%), hsl(38 85% 50%), hsl(30 80% 38%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .glow-gold {
    box-shadow: 0 0 40px hsl(38 85% 50% / 0.18), 0 0 80px hsl(30 80% 38% / 0.1);
  }
  .glow-gold-strong {
    box-shadow: 0 0 0 1px hsl(38 85% 50% / 0.25), 0 20px 60px hsl(0 0% 0% / 0.5), 0 0 80px hsl(38 85% 50% / 0.18);
  }
  .steel-card {
    background: hsl(var(--card));
    border: 1px solid hsl(30 18% 16% / 0.8);
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px hsl(38 85% 50% / 0.06), 0 12px 40px hsl(0 0% 0% / 0.4);
    backdrop-filter: blur(12px);
  }
  .steel-card-hover {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .steel-card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 0 1px hsl(38 85% 50% / 0.22), 0 20px 60px hsl(0 0% 0% / 0.5), 0 0 60px hsl(38 85% 50% / 0.14);
  }
  .bg-gold-glow {
    background: radial-gradient(ellipse at 30% 20%, hsl(38 85% 50% / 0.12), transparent 60%),
                radial-gradient(ellipse at 70% 80%, hsl(30 80% 38% / 0.08), transparent 50%);
  }
}

* { box-sizing: border-box; }
html, body {
  background-image:
    radial-gradient(circle at 18% 12%, rgba(245, 158, 11, 0.16), transparent 46%),
    radial-gradient(circle at 82% 58%, rgba(220, 38, 38, 0.10), transparent 50%);
  background-attachment: fixed; padding: 0; margin: 0; }

a{ color:inherit; }

.container{
  max-width:1100px;
  margin:0 auto;
  padding: 22px;
}

.topbar{
  position: sticky;
  top:0;
  z-index:20;
  background: color-mix(in oklab, var(--theme-bg) 92%, white 8%);
  border-bottom:1px solid var(--border);
  backdrop-filter: blur(10px);
}

.nav{
  display:flex;
  gap:10px;
  align-items:center;
  justify-content:space-between;
  padding: 14px 22px;
  max-width:1100px;
  margin:0 auto;
}

.brand{
  font-weight:900;
  letter-spacing:.2px;
}

.navlinks{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }

.pill{
  border:1px solid var(--border);
  border-radius: 999px;
  padding: 9px 12px;
  text-decoration:none;
  font-weight:800;
  font-size:13px;
  background:#fff;
}

.pillPrimary{
  border:1px solid color-mix(in oklab, var(--theme-accent) 45%, var(--border) 55%);
  background: color-mix(in oklab, var(--theme-accent) 12%, #fff 88%);
}

.hero{
  border:1px solid var(--border);
  border-radius: calc(var(--radius) + 6px);
  padding: 22px;
  background:
    radial-gradient(600px 220px at 18% 20%, color-mix(in oklab, var(--theme-accent) 22%, transparent 78%), transparent 60%),
    radial-gradient(600px 220px at 85% 25%, color-mix(in oklab, var(--theme-accent) 18%, transparent 82%), transparent 65%),
    #fff;
  box-shadow: var(--shadow);
}

.hero h1{ margin:0; font-size: 30px; font-weight: 950; }
.hero p{ margin:10px 0 0 0; opacity:.78; max-width: 70ch; }

.grid{
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 14px;
  margin-top: 12px;
}

.card{
  display:block;
  border:1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px;
  text-decoration:none;
  background:#fff;
  box-shadow: var(--shadow);
  transition: transform .12s ease, box-shadow .12s ease;
}

.card:hover{
  transform: translateY(-2px);
  box-shadow: var(--shadowHover);
}

.cardTitle{ font-weight: 900; }
.badges{ display:flex; gap:8px; align-items:center; }
.badge{
  font-size:11px;
  padding:2px 8px;
  border:1px solid var(--border);
  border-radius: 999px;
  font-weight:900;
  opacity:.9;
}
.price{ margin-top: 6px; font-weight: 950; font-size: 18px; }
.meta{ margin-top: 6px; font-size:12px; opacity:.72; }

.thumb{
  width:100%;
  height:150px;
  object-fit:cover;
  border-radius: 10px;
  border:1px solid var(--border);
  background:#fafafa;
}

.sectionTitle{
  display:flex;
  gap:10px;
  align-items:baseline;
  margin-top: 22px;
}
.sectionTitle h2{ margin:0; font-size:22px; font-weight: 950; }
.sectionTitle span{ font-size:13px; opacity:.65; }

.footer{
  margin-top: 28px;
  padding-top: 18px;
  border-top:1px solid var(--border);
  opacity:.75;
  font-size:13px;
}

.floatCart{
  position: fixed;
  right: 18px;
  bottom: 18px;
  z-index: 50;
  display: inline-flex;
  gap: 10px;
  align-items: center;
  padding: 12px 14px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: color-mix(in oklab, var(--theme-accent) 10%, #fff 90%);
  box-shadow: var(--shadowHover);
  text-decoration: none;
}

.floatCartBadge{
  min-width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: #fff;
  font-weight: 950;
}

.bannerRow{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 16px;
}

@media (max-width: 900px){
  .bannerRow{ grid-template-columns: 1fr; }
}

.bannerCard{
  border:1px solid var(--border);
  border-radius: calc(var(--radius) + 6px);
  padding: 16px;
  background:
    radial-gradient(600px 220px at 18% 20%, color-mix(in oklab, var(--theme-accent) 22%, transparent 78%), transparent 60%),
    radial-gradient(600px 220px at 85% 25%, color-mix(in oklab, var(--theme-accent) 16%, transparent 84%), transparent 65%),
    #fff;
  box-shadow: var(--shadow);
}

.bannerTitle{ font-weight: 950; font-size: 18px; margin:0; }
.bannerText{ margin-top: 6px; opacity: .82; }
.bannerActions{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 12px; }

.chips{
  display:flex;
  gap: 10px;
  flex-wrap: wrap;
  margin: 12px 0 14px 0;
}

.chip{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding: 8px 12px;
  border:1px solid var(--border);
  border-radius: 999px;
  text-decoration:none;
  font-weight: 900;
  font-size: 12px;
  background:#fff;
}

.chipOn{
  border:1px solid color-mix(in oklab, var(--theme-accent) 45%, var(--border) 55%);
  background: color-mix(in oklab, var(--theme-accent) 12%, #fff 88%);
}

.chipDot{
  width:10px;
  height:10px;
  border-radius:999px;
  background: color-mix(in oklab, var(--theme-accent) 55%, #999 45%);
  display:inline-block;
}

/* ===== STEEL_THEME_V1 (Delima) ===== */
:root{
  --steel-bg: url("/brand/bg-steel.png");
  --steel-overlay: radial-gradient(1200px 500px at 20% 0%, rgba(255,140,0,.35), transparent 60%),
                   radial-gradient(900px 400px at 80% 10%, rgba(255,60,0,.22), transparent 55%),
                   radial-gradient(1100px 700px at 50% 90%, rgba(255,210,120,.10), transparent 65%);
  --steel-surface: rgba(20,20,22,.72);
  --steel-border: rgba(255,160,40,.16);
  --steel-glow: 0 0 0 1px rgba(255,160,40,.12), 0 12px 30px rgba(0,0,0,.35), 0 0 40px rgba(255,120,0,.12);
  --steel-glow-strong: 0 0 0 1px rgba(255,160,40,.22), 0 16px 44px rgba(0,0,0,.45), 0 0 60px rgba(255,120,0,.18);
  --spark1: #ffcc66;
  --spark2: #ff7a00;
  --spark3: #ff2a00;
}

body {
  background-image:
    radial-gradient(circle at 18% 12%, rgba(245, 158, 11, 0.16), transparent 46%),
    radial-gradient(circle at 82% 58%, rgba(220, 38, 38, 0.10), transparent 50%);
  background-attachment: fixed;
  background-image: var(--steel-overlay), var(--steel-bg);
  background-size: cover, cover;
  background-repeat: no-repeat, no-repeat;
  background-attachment: fixed, fixed;
}

/* cards/sections */
.steelCard{
  background: color-mix(in oklab, var(--steel-surface) 92%, rgba(255,255,255,.06) 8%);
  border: 1px solid var(--steel-border);
  border-radius: 16px;
  box-shadow: var(--steel-glow);
  backdrop-filter: blur(10px);
}

/* botões tech */
.steelBtn{
  border-radius: 999px;
  border: 1px solid rgba(255,160,40,.35);
  padding: 10px 14px;
  font-weight: 850;
  background: linear-gradient(180deg, rgba(255,130,0,.22), rgba(0,0,0,.0));
  box-shadow: 0 10px 22px rgba(0,0,0,.32), 0 0 26px rgba(255,120,0,.16);
  transition: transform .12s ease, box-shadow .12s ease;
}
.steelBtn:hover{ transform: translateY(-1px); box-shadow: var(--steel-glow-strong); }
.steelBtn:active{ transform: translateY(0px) scale(.98); }

/* canvas por cima para faíscas */
#spark-canvas{
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
}
/* ===== /STEEL_THEME_V1 ===== */

