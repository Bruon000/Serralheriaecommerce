"use client";

import React, { useCallback, useEffect, useState } from "react";
import type { CmsBlock, CmsPageContent } from "@/lib/cms/types";
import { createBlock } from "@/lib/cms/types";
import BlockList from "./BlockList";
import BlockPropsPanel from "./BlockPropsPanel";
import CmsRenderer from "./Renderer";

type PageRow = {
  id: string;
  urlPath: string;
  title: string | null;
  contentJson: string | null;
  published: boolean;
  updatedAt: string;
};

type Props = {
  initialPages: PageRow[];
};

export default function CmsEditor({ initialPages }: Props) {
  const [pages, setPages] = useState<PageRow[]>(initialPages);
  const [urlPath, setUrlPath] = useState("/");
  const [title, setTitle] = useState("");
  const [blocks, setBlocks] = useState<CmsBlock[]>([]);
  const [selectedBlockId, setSelectedBlockId] = useState<string | null>(null);
  const [published, setPublished] = useState(false);
  const [pageId, setPageId] = useState<string | null>(null);
  const [toast, setToast] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [autosave, setAutosave] = useState(false);
  const [autosaveSeconds] = useState(30);

  const loadPage = useCallback(async (path: string) => {
    setError(null);
    try {
      const res = await fetch(`/api/cms/page?urlPath=${encodeURIComponent(path)}`);
      if (res.status === 401) {
        window.location.href = "/admin/login";
        return;
      }
      if (res.status === 404) {
        setPageId(null);
        setTitle("");
        setBlocks([]);
        setPublished(false);
        setSelectedBlockId(null);
        return;
      }
      const data = await res.json();
      if (!data.ok || !data.page) return;
      const p = data.page;
      setPageId(p.id);
      setTitle(p.title ?? "");
      setPublished(p.published ?? false);
      setSelectedBlockId(null);
      try {
        const content = p.contentJson ? (JSON.parse(p.contentJson) as CmsPageContent) : null;
        setBlocks(content?.blocks ?? []);
      } catch {
        setBlocks([]);
      }
    } catch (e) {
      setError("Erro ao carregar página");
      setBlocks([]);
    }
  }, []);

  useEffect(() => {
    loadPage(urlPath);
  }, [urlPath, loadPage]);

  const selectedBlock = blocks.find((b) => b.id === selectedBlockId) ?? null;

  const updateBlock = useCallback((updated: CmsBlock) => {
    setBlocks((prev) =>
      prev.map((b) => (b.id === updated.id ? updated : b))
    );
  }, []);

  const addBlock = useCallback((type: CmsBlock["type"]) => {
    const newBlock = createBlock(type);
    setBlocks((prev) => [...prev, newBlock]);
    setSelectedBlockId(newBlock.id);
  }, []);

  const save = useCallback(async () => {
    setError(null);
    if (!urlPath.startsWith("/")) {
      setError("urlPath deve começar com /");
      return;
    }
    const contentJson = JSON.stringify({ blocks });
    try {
      const res = await fetch("/api/cms/pages", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          urlPath,
          title: title || null,
          contentJson,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) {
        setError(data.error ?? "Erro ao salvar");
        return;
      }
      setToast("Salvo!");
      setTimeout(() => setToast(null), 3000);
      setPageId(data.page?.id ?? pageId);
      const listRes = await fetch("/api/cms/pages");
      const listData = await listRes.json();
      if (listData.pages) setPages(listData.pages);
    } catch {
      setError("Erro ao salvar");
    }
  }, [urlPath, title, blocks, pageId]);

  const publish = useCallback(async () => {
    setError(null);
    try {
      const res = await fetch("/api/cms/pages", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ urlPath, published: true }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) {
        setError(data.error ?? "Erro ao publicar");
        return;
      }
      setPublished(true);
      setToast("Publicado!");
      setTimeout(() => setToast(null), 3000);
    } catch {
      setError("Erro ao publicar");
    }
  }, [urlPath]);

  const previewHref = urlPath || "/";

  useEffect(() => {
    if (!autosave || blocks.length === 0) return;
    const t = setInterval(save, autosaveSeconds * 1000);
    return () => clearInterval(t);
  }, [autosave, autosaveSeconds, blocks, save]);

  // Escuta clique no preview (iframe): seleciona o bloco no painel
  useEffect(() => {
    const handler = (event: MessageEvent) => {
      const data = event.data as { type?: string; urlPath?: string; blockId?: string } | undefined;
      if (data?.type !== "CMS_SELECT" || data.urlPath !== urlPath || !data.blockId) return;
      setSelectedBlockId(data.blockId);
    };
    window.addEventListener("message", handler);
    return () => window.removeEventListener("message", handler);
  }, [urlPath]);

  return (
    <>
    <div className="grid gap-6 lg:grid-cols-[280px_1fr_320px]">
      {/* Coluna esquerda: lista de páginas + blocos */}
      <div className="space-y-4">
        <div className="steel-card p-4">
          <div className="text-sm font-extrabold text-foreground/90 mb-3">Página</div>
          <div className="grid gap-2">
            {pages.length > 0 && (
              <>
                <label className="text-xs text-muted-foreground">Carregar existente</label>
                <select
                  className="h-10 w-full rounded-xl border border-border/50 bg-black/35 px-3 text-sm"
                  value=""
                  onChange={(e) => {
                    const v = e.target.value;
                    if (v) setUrlPath(v);
                  }}
                >
                  <option value="">— escolher —</option>
                  {pages.map((p) => (
                    <option key={p.id} value={p.urlPath}>{p.urlPath}</option>
                  ))}
                </select>
              </>
            )}
            <label className="text-xs text-muted-foreground">URL (urlPath)</label>
            <input
              className="h-10 w-full rounded-xl border border-border/50 bg-black/35 px-3 text-sm"
              value={urlPath}
              onChange={(e) => setUrlPath(e.target.value)}
              placeholder="/minha-pagina"
            />
            <label className="text-xs text-muted-foreground">Título (opcional)</label>
            <input
              className="h-10 w-full rounded-xl border border-border/50 bg-black/35 px-3 text-sm"
              value={title}
              onChange={(e) => setTitle(e.target.value)}
              placeholder="Título da página"
            />
          </div>
        </div>
        <div className="steel-card p-4">
          <BlockList
            blocks={blocks}
            selectedId={selectedBlockId}
            onBlocksChange={setBlocks}
            onSelectBlock={setSelectedBlockId}
            onAddBlock={addBlock}
          />
        </div>
      </div>

      {/* Centro: preview canvas */
      <div className="flex flex-col gap-4 min-h-0">
        <div className="steel-card p-4 flex flex-wrap items-center justify-between gap-3">
          <span className="text-sm font-extrabold text-foreground/90">Preview</span>
          <div className="flex flex-wrap items-center gap-2">
            <a
              href={previewHref}
              target="_blank"
              rel="noreferrer"
              className="inline-flex items-center rounded-full border border-border/60 bg-black/25 px-4 py-2 text-xs font-extrabold hover:bg-black/40"
            >
              Abrir em nova aba
            </a>

            <button
              type="button"
              onClick={save}
              className="inline-flex items-center rounded-full bg-primary px-4 py-2 text-xs font-extrabold text-primary-foreground hover:brightness-110"
            >
              Salvar
            </button>

            {!published && (
              <button
                type="button"
                onClick={publish}
                className="inline-flex items-center rounded-full border border-primary/60 bg-primary/20 px-4 py-2 text-xs font-extrabold text-primary-foreground/90 hover:bg-primary/30"
              >
                Publicar
              </button>
            )}

            {published && (
              <span className="rounded-full bg-green-500/20 px-3 py-1 text-xs font-extrabold text-green-400">
                Publicado
              </span>
            )}

            <label className="flex items-center gap-2 text-xs text-muted-foreground">
              <input
                type="checkbox"
                checked={autosave}
                onChange={(e) => setAutosave(e.target.checked)}
              />
              Autosave ({autosaveSeconds}s)
            </label>
          </div>
        </div>

        <div className="steel-card flex-1 min-h-[400px] overflow-hidden">
          <div className="p-4 h-full overflow-auto bg-background/50">
            <div className="container max-w-6xl py-6">
              <CmsRenderer
                content={{ blocks }}
                interactive
                selectedId={selectedBlockId}
                onSelectBlock={setSelectedBlockId}
              />
            </div>
          </div>
        </div>
      </div>

      {/* Coluna direita: propriedades do bloco */}
      <div className="steel-card p-4">
        <div className="text-sm font-extrabold text-foreground/90 mb-3">Propriedades</div>
        <BlockPropsPanel block={selectedBlock} onChange={updateBlock} />
      </div>
    </div>

    {toast && (
      <div className="fixed bottom-6 right-6 rounded-xl bg-primary/90 px-4 py-2 text-sm font-extrabold text-primary-foreground shadow-lg z-50">
        {toast}
      </div>
    )}
    {error && (
      <div className="fixed top-20 left-1/2 -translate-x-1/2 rounded-xl border border-red-500/50 bg-red-500/10 px-4 py-2 text-sm text-red-300 z-50 max-w-md">
        {error}
      </div>
    )}
    </>
  );
}


