              <input className="w-20 rounded-md border border-border bg-black/40 px-2 py-1 text-xs" type="number" min="12" max="20" value={s.cartCtaText} onChange={(e) => setS(x => ({...x, cartCtaText: Number(e.target.value)}))} />
            </div>
          </div>
        </div>
      ) : null}


      <div className="mt-3 text-[10px] text-foreground/60">
        abre com <span className="font-bold">?tune=1</span> • não salva nada • só pra ajustar rápido
      </div>
    </div>
  );
}





