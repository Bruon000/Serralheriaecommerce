import Link from "next/link";
import { listProducts } from "../../lib/medusa";

export const dynamic = "force-dynamic";

export default async function PromocoesPage() {
  const all = await listProducts();
  const promo = (all || []).filter((p: any) => p?.metadata?.promocao === "semana");

  return (
    <main className="tune-page container py-12">
      <div className="tune-page flex items-center justify-between gap-4 mb-10">
        <h1 className="tune-page font-display text-4xl font-bold">
          Promoções <span className="tune-page text-gradient-gold">da semana</span>
        </h1>
        <Link href="/catalogo" className="tune-page text-sm font-bold text-primary">
          Ver catálogo
        </Link>
      </div>

      {promo.length === 0 ? (
        <div className="tune-page steel-card p-6 text-muted-foreground">
          Nenhuma promoção ativa no momento.
        </div>
      ) : (
        <div className="tune-page grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {promo.map((p: any) => (
            <Link key={p.id} href={`/produto/${p.handle}`} className="tune-page steel-card steel-card-hover p-5 block">
              <div className="tune-page font-bold">{p.title}</div>
              <div className="tune-page text-sm text-muted-foreground mt-2">Ver detalhes</div>
            </Link>
          ))}
        </div>
      )}
    </main>
  );
}


