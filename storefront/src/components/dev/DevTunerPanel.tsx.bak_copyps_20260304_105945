"use client";

import React, { useEffect, useMemo, useState } from "react";

export default function DevTunerPanel() {
  const enabled = useMemo(() => {
    if (process.env.NODE_ENV === "production") return false;
    try {
      const v = new URLSearchParams(window.location.search).get("tune");
      return v === "1" || v === "true" || v === "on";
    } catch {
      return false;
    }
  }, []);

  const [pageKey, setPageKey] = useState("");
  const [pathname, setPathname] = useState("");
  const [activeLabel, setActiveLabel] = useState("nada");

  const [s, setS] = useState({
    // Geral (todas)
    pageMaxW: 1200,
    pagePadX: 16,
    pagePadTop: 0,
    pagePadBottom: 0,

    // Home (logo grande)
    heroH: 320,
    heroX: 0,
    heroY: -10,
    heroRot: -12,

    // Header
    headerLogoH: 40,

    // ColumnsLayout (quando usado)
    colsGap: 16,
    colsBase: 1,
    colsLg: 2,
    colsXl: 2,

    // Catálogo (cards)
    catalogGridGap: 24,
    catalogCardPad: 20,
    catalogTitleSize: 18,
    catalogImgScale: 110,

    // Produto (layout)
    productMaxW: 1200,
    productPadX: 16,

    // Carrinho (resumo)
    cartSummaryW: 360,
    cartTotalSize: 30,
    cartCtaPy: 12,
    cartCtaPx: 16,
    cartCtaText: 14,
  });

  const setTarget = (id, label) => {
    setActiveLabel(label || id);
    try {
      document.documentElement.setAttribute("data-tune-target", id);
    } catch {}
  };

  const clearTarget = () => {
    setActiveLabel("nada");
    try {
      document.documentElement.removeAttribute("data-tune-target");
    } catch {}
  };

  // marca página atual (via TunePageMarker) e pathname
  useEffect(() => {
    if (!enabled) return;
    const read = () => {
      setPageKey(document.documentElement.getAttribute("data-tune-page") || "");
      setPathname(window.location.pathname || "");
    };
    read();
    const t = setInterval(read, 300);
    return () => clearInterval(t);
  }, [enabled]);

  // ativa data-dev-tune
  useEffect(() => {
    if (!enabled) {
      try {
        document.documentElement.removeAttribute("data-dev-tune");
        document.documentElement.removeAttribute("data-tune-target");
      } catch {}
      return;
    }
    try {
      document.documentElement.setAttribute("data-dev-tune", "1");
    } catch {}
  }, [enabled]);

  // aplica vars
  useEffect(() => {
    if (!enabled) return;
    const setVar = (k, v) => document.documentElement.style.setProperty(k, v);

    // geral
    setVar("--pageMaxW", `${s.pageMaxW}px`);
    setVar("--pagePadX", `${s.pagePadX}px`);
    setVar("--pagePadTop", `${s.pagePadTop}px`);
    setVar("--pagePadBottom", `${s.pagePadBottom}px`);

    // home hero
    setVar("--heroLogoH", `${s.heroH}px`);
    setVar("--heroLogoX", `${s.heroX}px`);
    setVar("--heroLogoY", `${s.heroY}px`);
    setVar("--heroLogoRot", `${s.heroRot}deg`);

    // header
    setVar("--headerLogoH", `${s.headerLogoH}px`);

    // columns layout
    setVar("--devColsGap", `${s.colsGap}px`);
    setVar("--devColsBase", `${s.colsBase}`);
    setVar("--devColsLg", `${s.colsLg}`);
    setVar("--devColsXl", `${s.colsXl}`);

    // catálogo
    setVar("--catalogGridGap", `${s.catalogGridGap}px`);
    setVar("--catalogCardPad", `${s.catalogCardPad}px`);
    setVar("--catalogTitleSize", `${s.catalogTitleSize}px`);
    setVar("--catalogImgScale", `${s.catalogImgScale}`);

    // produto
    setVar("--productMaxW", `${s.productMaxW}px`);
    setVar("--productPadX", `${s.productPadX}px`);

    // carrinho
    setVar("--cartSummaryW", `${s.cartSummaryW}px`);
    setVar("--cartTotalSize", `${s.cartTotalSize}px`);
    setVar("--cartCtaPy", `${s.cartCtaPy}px`);
    setVar("--cartCtaPx", `${s.cartCtaPx}px`);
    setVar("--cartCtaText", `${s.cartCtaText}px`);
  }, [enabled, s]);

  if (!enabled) return null;

  const Row = ({ label, hint, children }) => (
    <div className="flex items-center justify-between gap-3 py-1.5">
      <div className="min-w-[150px]">
        <div className="text-xs font-bold text-foreground/85">{label}</div>
        {hint ? <div className="text-[10px] text-foreground/55">{hint}</div> : null}
      </div>
      <div className="flex items-center gap-2">{children}</div>
    </div>
  );

  const Num = ({ value, min, max, step, onChange }) => (
    <input
      className="w-20 rounded-md border border-border bg-black/40 px-2 py-1 text-xs"
      type="number"
      value={value}
      min={min}
      max={max}
      step={step ?? 1}
      onChange={(e) => onChange(Number(e.target.value))}
    />
  );

  const Range = ({ value, min, max, step, onChange }) => (
    <input
      className="w-56"
      type="range"
      value={value}
      min={min}
      max={max}
      step={step ?? 1}
      onChange={(e) => onChange(Number(e.target.value))}
    />
  );

  const Section = ({ title, where, targetId, targetLabel, children }) => (
    <div className="rounded-lg border border-border/50 bg-black/30 p-2">
      <div className="mb-1 flex items-center justify-between">
        <button
          className="text-left text-xs font-extrabold hover:underline"
          onClick={() => setTarget(targetId, targetLabel)}
          title="clicar aqui destaca no site"
        >
          {title}
        </button>
        <div className="text-[10px] text-foreground/60">{where}</div>
      </div>
      {children}
    </div>
  );

  const onReset = () =>
    setS((x) => ({
      ...x,
      pageMaxW: 1200,
      pagePadX: 16,
      pagePadTop: 0,
      pagePadBottom: 0,
      heroH: 320,
      heroX: 0,
      heroY: -10,
      heroRot: -12,
      headerLogoH: 40,
      colsGap: 16,
      colsBase: 1,
      colsLg: 2,
      colsXl: 2,
      catalogGridGap: 24,
      catalogCardPad: 20,
      catalogTitleSize: 18,
      catalogImgScale: 110,
      productMaxW: 1200,
      productPadX: 16,
      cartSummaryW: 360,
      cartTotalSize: 30,
      cartCtaPy: 12,
      cartCtaPx: 16,
      cartCtaText: 14,
    }));

  return (
    <div className="fixed bottom-4 right-4 z-[9999] w-[520px] max-w-[96vw] rounded-xl border border-border/60 bg-black/80 p-3 shadow-[0_30px_90px_rgba(0,0,0,0.45)] backdrop-blur">
      <div className="flex items-start justify-between gap-2">
        <div>
          <div className="text-sm font-extrabold">Ajustes rápidos</div>
          <div className="text-[10px] text-foreground/60">
            Página: <span className="font-bold">{pageKey || "..."}</span>{" "}
            <span className="text-foreground/50">{pathname ? `(${pathname})` : ""}</span>
          </div>
          <div className="text-[10px] text-foreground/70">
            Mexendo agora: <span className="font-bold text-foreground/90">{activeLabel}</span>{" "}
            <button className="ml-2 underline text-foreground/60 hover:text-foreground" onClick={clearTarget}>
              limpar destaque
            </button>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button className="rounded-md border border-border bg-black/30 px-2 py-1 text-xs font-bold hover:bg-black/50" onClick={onReset}>
            Reset
          </button>
        </div>
      </div>

      <div className="mt-3 max-h-[72vh] space-y-3 overflow-auto pr-1">
        {/* SEMPRE: Geral */}
        <Section title="Geral • Página" where='mexe em: layout (tune-root)' targetId="geral" targetLabel="Geral • Página">
          <Row label="Largura do miolo" hint="max-width">
            <Range value={s.pageMaxW} min={900} max={1800} step={10} onChange={(v) => setS((x) => ({ ...x, pageMaxW: v }))} />
            <Num value={s.pageMaxW} min={900} max={1800} step={10} onChange={(v) => setS((x) => ({ ...x, pageMaxW: v }))} />
          </Row>
          <Row label="Margem lateral" hint="padding X">
            <Range value={s.pagePadX} min={0} max={80} onChange={(v) => setS((x) => ({ ...x, pagePadX: v }))} />
            <Num value={s.pagePadX} min={0} max={80} onChange={(v) => setS((x) => ({ ...x, pagePadX: v }))} />
          </Row>
          <Row label="Espaço em cima" hint="padding-top">
            <Range value={s.pagePadTop} min={0} max={160} step={2} onChange={(v) => setS((x) => ({ ...x, pagePadTop: v }))} />
            <Num value={s.pagePadTop} min={0} max={160} step={2} onChange={(v) => setS((x) => ({ ...x, pagePadTop: v }))} />
          </Row>
          <Row label="Espaço embaixo" hint="padding-bottom">
            <Range value={s.pagePadBottom} min={0} max={200} step={2} onChange={(v) => setS((x) => ({ ...x, pagePadBottom: v }))} />
            <Num value={s.pagePadBottom} min={0} max={200} step={2} onChange={(v) => setS((x) => ({ ...x, pagePadBottom: v }))} />
          </Row>
        </Section>

        {/* HOME */}
        {pageKey === "home" ? (
          <Section title="Home • Logo grande" where="mexe em: HeroSection.tsx" targetId="geral" targetLabel="Home • Logo grande">
            <Row label="Altura" hint="tamanho do logo">
              <Range value={s.heroH} min={160} max={520} step={2} onChange={(v) => setS((x) => ({ ...x, heroH: v }))} />
              <Num value={s.heroH} min={160} max={520} step={2} onChange={(v) => setS((x) => ({ ...x, heroH: v }))} />
            </Row>
            <Row label="Lado (X)" hint="esquerda / direita">
              <Range value={s.heroX} min={-400} max={400} onChange={(v) => setS((x) => ({ ...x, heroX: v }))} />
              <Num value={s.heroX} min={-400} max={400} onChange={(v) => setS((x) => ({ ...x, heroX: v }))} />
            </Row>
            <Row label="Cima/baixo (Y)" hint="sobe / desce">
              <Range value={s.heroY} min={-400} max={400} onChange={(v) => setS((x) => ({ ...x, heroY: v }))} />
              <Num value={s.heroY} min={-400} max={400} onChange={(v) => setS((x) => ({ ...x, heroY: v }))} />
            </Row>
            <Row label="Giro" hint="rotaciona">
              <Range value={s.heroRot} min={-45} max={45} onChange={(v) => setS((x) => ({ ...x, heroRot: v }))} />
              <Num value={s.heroRot} min={-45} max={45} onChange={(v) => setS((x) => ({ ...x, heroRot: v }))} />
            </Row>
          </Section>
        ) : null}

        {/* CATÁLOGO */}
        {pageKey === "catalogo" ? (
          <>
            <Section title="Catálogo • Grade" where="mexe em: src/app/catalogo/page.tsx (grid)" targetId="catalog-grid" targetLabel="Catálogo • Grade">
              <Row label="Espaço entre cards" hint="gap do grid">
                <Range value={s.catalogGridGap} min={8} max={64} onChange={(v) => setS((x) => ({ ...x, catalogGridGap: v }))} />
                <Num value={s.catalogGridGap} min={8} max={64} onChange={(v) => setS((x) => ({ ...x, catalogGridGap: v }))} />
              </Row>
            </Section>

            <Section title="Catálogo • Card" where="mexe em: src/app/catalogo/page.tsx (steel-card)" targetId="catalog-card" targetLabel="Catálogo • Card">
              <Row label="Padding do card" hint="respiro interno">
                <Range value={s.catalogCardPad} min={10} max={40} onChange={(v) => setS((x) => ({ ...x, catalogCardPad: v }))} />
                <Num value={s.catalogCardPad} min={10} max={40} onChange={(v) => setS((x) => ({ ...x, catalogCardPad: v }))} />
              </Row>
              <Row label="Título do card" hint="tamanho do nome">
                <Range value={s.catalogTitleSize} min={14} max={28} onChange={(v) => setS((x) => ({ ...x, catalogTitleSize: v }))} />
                <Num value={s.catalogTitleSize} min={14} max={28} onChange={(v) => setS((x) => ({ ...x, catalogTitleSize: v }))} />
              </Row>
              <Row label="Zoom da imagem" hint="hover scale">
                <Range value={s.catalogImgScale} min={100} max={140} onChange={(v) => setS((x) => ({ ...x, catalogImgScale: v }))} />
                <Num value={s.catalogImgScale} min={100} max={140} onChange={(v) => setS((x) => ({ ...x, catalogImgScale: v }))} />
              </Row>
            </Section>
          </>
        ) : null}

        {/* PRODUTO */}
        {pageKey === "produto" ? (
          <Section title="Produto • Layout" where="mexe em: src/app/produto/[handle]/page.tsx" targetId="product-main" targetLabel="Produto • Layout">
            <Row label="Largura do miolo" hint="max-width">
              <Range value={s.productMaxW} min={900} max={1680} step={10} onChange={(v) => setS((x) => ({ ...x, productMaxW: v }))} />
              <Num value={s.productMaxW} min={900} max={1680} step={10} onChange={(v) => setS((x) => ({ ...x, productMaxW: v }))} />
            </Row>
            <Row label="Margem lateral" hint="padding X">
              <Range value={s.productPadX} min={0} max={64} onChange={(v) => setS((x) => ({ ...x, productPadX: v }))} />
              <Num value={s.productPadX} min={0} max={64} onChange={(v) => setS((x) => ({ ...x, productPadX: v }))} />
            </Row>
          </Section>
        ) : null}

        {/* CARRINHO */}
        {pageKey === "carrinho" ? (
          <Section title="Carrinho • Resumo" where="mexe em: CarrinhoBody.tsx" targetId="cart-summary" targetLabel="Carrinho • Resumo">
            <Row label="Largura do resumo" hint="lado direito">
              <Range value={s.cartSummaryW} min={260} max={520} onChange={(v) => setS((x) => ({ ...x, cartSummaryW: v }))} />
              <Num value={s.cartSummaryW} min={260} max={520} onChange={(v) => setS((x) => ({ ...x, cartSummaryW: v }))} />
            </Row>
            <Row label="Tamanho do TOTAL" hint="texto do preço">
              <Range value={s.cartTotalSize} min={18} max={46} onChange={(v) => setS((x) => ({ ...x, cartTotalSize: v }))} />
              <Num value={s.cartTotalSize} min={18} max={46} onChange={(v) => setS((x) => ({ ...x, cartTotalSize: v }))} />
            </Row>
          </Section>
        ) : null}
      </div>

      <div className="mt-3 text-[10px] text-foreground/60">
        abre com <span className="font-bold">?tune=1</span> • clicar no título do bloco destaca no site
      </div>
    </div>
  );
}
