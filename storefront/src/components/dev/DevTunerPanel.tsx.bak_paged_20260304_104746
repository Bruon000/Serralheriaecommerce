"use client";

import React, { useEffect, useMemo, useState } from "react";

export default function DevTunerPanel() {
  const enabled = useMemo(() => {
    if (process.env.NODE_ENV === "production") return false;
    try {
      const v = new URLSearchParams(window.location.search).get("tune");
      return v === "1" || v === "true" || v === "on";
    } catch {
      return false;
    }
  }, []);

  const [pageKey, setPageKey] = useState("");
  const [s, setS] = useState({
    // Hero (home)
    heroH: 320,
    heroX: 0,
    heroY: -10,
    heroRot: -12,

    
    // Geral (todas as páginas)
    pageMaxW: 1200,
    pagePadX: 16,
    pagePadTop: 0,
    pagePadBottom: 0,// Header
    headerLogoH: 40,

    // Grid/Columns
    colsGap: 16,
    colsBase: 1,
    colsLg: 2,
    colsXl: 2,

    // Product header
    prodPad: 16,
    prodTitle: 30,

    // Carrinho
    cartSummaryW: 360,
    cartTotalSize: 30,
    cartCtaPy: 12,
    cartCtaPx: 16,
    cartCtaText: 14,
  });

  // leitura da página (setado pelo TunePageMarker)
  useEffect(() => {
    if (!enabled) return;
    const read = () => setPageKey(document.documentElement.getAttribute("data-tune-page") || "");
    read();
    const t = setInterval(read, 300);
    return () => clearInterval(t);
  }, [enabled]);

  // aplica/remove modo tune + css vars
  useEffect(() => {
    if (!enabled) {
      document.documentElement.removeAttribute("data-dev-tune");
      return;
    }
    document.documentElement.setAttribute("data-dev-tune", "1");
  }, [enabled]);

  useEffect(() => {
    if (!enabled) return;

    const setVar = (k, v) => document.documentElement.style.setProperty(k, v);

    // Hero
    setVar("--heroLogoH", `${s.heroH}px`);
    setVar("--heroLogoX", `${s.heroX}px`);
    setVar("--heroLogoY", `${s.heroY}px`);
    setVar("--heroLogoRot", `${s.heroRot}deg`);

    
    // Geral (todas as páginas)
    setVar("--pageMaxW", `${s.pageMaxW}px`);
    setVar("--pagePadX", `${s.pagePadX}px`);
    setVar("--pagePadTop", `${s.pagePadTop}px`);
    setVar("--pagePadBottom", `${s.pagePadBottom}px`);// Header
    setVar("--headerLogoH", `${s.headerLogoH}px`);

    // Grid
    setVar("--devColsGap", `${s.colsGap}px`);
    setVar("--devColsBase", `${s.colsBase}`);
    setVar("--devColsLg", `${s.colsLg}`);
    setVar("--devColsXl", `${s.colsXl}`);

    // Product
    setVar("--devProductHeaderPad", `${s.prodPad}px`);
    setVar("--devProductTitleSize", `${s.prodTitle}px`);

    // Carrinho
    setVar("--cartSummaryW", `${s.cartSummaryW}px`);
    setVar("--cartTotalSize", `${s.cartTotalSize}px`);
    setVar("--cartCtaPy", `${s.cartCtaPy}px`);
    setVar("--cartCtaPx", `${s.cartCtaPx}px`);
    setVar("--cartCtaText", `${s.cartCtaText}px`);
  }, [enabled, s]);

  if (!enabled) return null;

  const copy = async (text) => {
    try { await navigator.clipboard.writeText(text); } catch {}
  };

  const Row = ({ label, hint, children }) => (
    <div className="flex items-center justify-between gap-3 py-1.5">
      <div className="min-w-[150px]">
        <div className="text-xs font-bold text-foreground/85">{label}</div>
        {hint ? <div className="text-[10px] text-foreground/55">{hint}</div> : null}
      </div>
      <div className="flex items-center gap-2">{children}</div>
    </div>
  );

  const Num = ({ value, min, max, step, onChange }) => (
    <input
      className="w-20 rounded-md border border-border bg-black/40 px-2 py-1 text-xs"
      type="number"
      value={value}
      min={min}
      max={max}
      step={step ?? 1}
      onChange={(e) => onChange(Number(e.target.value))}
    />
  );

  const Range = ({ value, min, max, step, onChange }) => (
    <input
      className="w-56"
      type="range"
      value={value}
      min={min}
      max={max}
      step={step ?? 1}
      onChange={(e) => onChange(Number(e.target.value))}
    />
  );

  const applyPS = `$ErrorActionPreference="Stop"

# HERO (src\\components\\HeroSection.tsx) - precisa estar usando var(--heroLogoH, XXXpx) etc
$hero="src\\components\\HeroSection.tsx"
$h = Get-Content $hero -Raw
$h = $h -replace 'var\\(--heroLogoH,\\s*\\d+px\\)', 'var(--heroLogoH, ${s.heroH}px)'
$h = $h -replace 'var\\(--heroLogoX,\\s*[-\\d]+px\\)', 'var(--heroLogoX, ${s.heroX}px)'
$h = $h -replace 'var\\(--heroLogoY,\\s*[-\\d]+px\\)', 'var(--heroLogoY, ${s.heroY}px)'
$h = $h -replace 'var\\(--heroLogoRot,\\s*[-\\d]+deg\\)', 'var(--heroLogoRot, ${s.heroRot}deg)'
$h | Set-Content -Encoding UTF8 $hero
Write-Host "OK HERO"

# HEADER (src\\components\\SiteHeader.tsx) - precisa var(--headerLogoH, XXXpx)
$header="src\\components\\SiteHeader.tsx"
$hh = Get-Content $header -Raw
$hh = $hh -replace 'var\\(--headerLogoH,\\s*\\d+px\\)', 'var(--headerLogoH, ${s.headerLogoH}px)'
$hh | Set-Content -Encoding UTF8 $header
Write-Host "OK HEADER"
`;

  return (
    <div className="fixed bottom-4 right-4 z-[9999] w-[520px] max-w-[96vw] rounded-xl border border-border/60 bg-black/80 p-3 shadow-[0_30px_90px_rgba(0,0,0,0.45)] backdrop-blur">
      <div className="flex items-start justify-between gap-2">
        <div>
          <div className="text-sm font-extrabold">Ajustes rápidos</div>
          <div className="text-[10px] text-foreground/60">
            Página: <span className="font-bold">{pageKey || "..."}</span>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button
            className="rounded-md border border-border bg-black/30 px-2 py-1 text-xs font-bold hover:bg-black/50"
            onClick={() =>
              setS({
                heroH: 320, heroX: 0, heroY: -10, heroRot: -12,
                
    // Geral (todas as páginas)
    pageMaxW: 1200,
    pagePadX: 16,
    pagePadTop: 0,
    pagePadBottom: 0,headerLogoH: 40,
                colsGap: 16, colsBase: 1, colsLg: 2, colsXl: 2,
                prodPad: 16, prodTitle: 30,
                cartSummaryW: 360, cartTotalSize: 30, cartCtaPy: 12, cartCtaPx: 16, cartCtaText: 14,
              })
            }
          >
            Reset
          </button>

          <button
            className="rounded-md border border-border bg-black/30 px-2 py-1 text-xs font-bold hover:bg-black/50"
            onClick={() => copy(applyPS)}
            title="Copia um script PowerShell pra aplicar os números no código (Hero/Header)"
          >
            Copiar comando (PS)
          </button>
        </div>
      </div>

      <div className="mt-3 max-h-[72vh] space-y-3 overflow-auto pr-1">
        
        <div className="rounded-lg border border-border/50 bg-black/30 p-2">
          <div className="mb-1 flex items-center justify-between">
            <div className="text-xs font-extrabold">Geral • Página</div>
            <div className="text-[10px] text-foreground/60">mexe em: qualquer page.tsx (tune-page)</div>
          </div>

          <Row label="Largura do miolo" hint="max-width">
            <Range value={s.pageMaxW} min={900} max={1800} step={10} onChange={(v) => setS((x) => ({ ...x, pageMaxW: v }))} />
            <Num value={s.pageMaxW} min={900} max={1800} step={10} onChange={(v) => setS((x) => ({ ...x, pageMaxW: v }))} />
          </Row>

          <Row label="Margem lateral" hint="padding X">
            <Range value={s.pagePadX} min={0} max={80} onChange={(v) => setS((x) => ({ ...x, pagePadX: v }))} />
            <Num value={s.pagePadX} min={0} max={80} onChange={(v) => setS((x) => ({ ...x, pagePadX: v }))} />
          </Row>

          <Row label="Espaço em cima" hint="padding-top">
            <Range value={s.pagePadTop} min={0} max={160} step={2} onChange={(v) => setS((x) => ({ ...x, pagePadTop: v }))} />
            <Num value={s.pagePadTop} min={0} max={160} step={2} onChange={(v) => setS((x) => ({ ...x, pagePadTop: v }))} />
          </Row>

          <Row label="Espaço embaixo" hint="padding-bottom">
            <Range value={s.pagePadBottom} min={0} max={200} step={2} onChange={(v) => setS((x) => ({ ...x, pagePadBottom: v }))} />
            <Num value={s.pagePadBottom} min={0} max={200} step={2} onChange={(v) => setS((x) => ({ ...x, pagePadBottom: v }))} />
          </Row>
        </div>
<div className="rounded-lg border border-border/50 bg-black/30 p-2">
          <div className="mb-1 flex items-center justify-between">
            <div className="text-xs font-extrabold">Home • Logo grande</div>
            <div className="text-[10px] text-foreground/60">mexe em: HeroSection.tsx</div>
          </div>

          <Row label="Altura" hint="tamanho do logo">
            <Range value={s.heroH} min={160} max={520} step={2} onChange={(v) => setS((x) => ({ ...x, heroH: v }))} />
            <Num value={s.heroH} min={160} max={520} step={2} onChange={(v) => setS((x) => ({ ...x, heroH: v }))} />
          </Row>

          <Row label="Lado (X)" hint="esquerda / direita">
            <Range value={s.heroX} min={-400} max={400} onChange={(v) => setS((x) => ({ ...x, heroX: v }))} />
            <Num value={s.heroX} min={-400} max={400} onChange={(v) => setS((x) => ({ ...x, heroX: v }))} />
          </Row>

          <Row label="Cima/baixo (Y)" hint="sobe / desce">
            <Range value={s.heroY} min={-400} max={400} onChange={(v) => setS((x) => ({ ...x, heroY: v }))} />
            <Num value={s.heroY} min={-400} max={400} onChange={(v) => setS((x) => ({ ...x, heroY: v }))} />
          </Row>

          <Row label="Giro" hint="rotaciona">
            <Range value={s.heroRot} min={-45} max={45} onChange={(v) => setS((x) => ({ ...x, heroRot: v }))} />
            <Num value={s.heroRot} min={-45} max={45} onChange={(v) => setS((x) => ({ ...x, heroRot: v }))} />
          </Row>
        </div>

        <div className="rounded-lg border border-border/50 bg-black/30 p-2">
          <div className="mb-1 flex items-center justify-between">
            <div className="text-xs font-extrabold">Topo • Logo</div>
            <div className="text-[10px] text-foreground/60">mexe em: SiteHeader.tsx</div>
          </div>

          <Row label="Altura (px)" hint="tamanho do logo no topo">
            <Range value={s.headerLogoH} min={24} max={72} onChange={(v) => setS((x) => ({ ...x, headerLogoH: v }))} />
            <Num value={s.headerLogoH} min={24} max={72} onChange={(v) => setS((x) => ({ ...x, headerLogoH: v }))} />
          </Row>
        </div>

        <div className="rounded-lg border border-border/50 bg-black/30 p-2">
          <div className="mb-1 flex items-center justify-between">
            <div className="text-xs font-extrabold">Grade • Colunas</div>
            <div className="text-[10px] text-foreground/60">mexe em: ColumnsLayout.tsx</div>
          </div>

          <Row label="Espaço" hint="gap entre cards">
            <Range value={s.colsGap} min={0} max={64} onChange={(v) => setS((x) => ({ ...x, colsGap: v }))} />
            <Num value={s.colsGap} min={0} max={64} onChange={(v) => setS((x) => ({ ...x, colsGap: v }))} />
          </Row>

          <Row label="Colunas (celular)" hint="base">
            <Range value={s.colsBase} min={1} max={4} onChange={(v) => setS((x) => ({ ...x, colsBase: v }))} />
            <Num value={s.colsBase} min={1} max={4} onChange={(v) => setS((x) => ({ ...x, colsBase: v }))} />
          </Row>

          <Row label="Colunas (pc)" hint="lg">
            <Range value={s.colsLg} min={1} max={4} onChange={(v) => setS((x) => ({ ...x, colsLg: v }))} />
            <Num value={s.colsLg} min={1} max={4} onChange={(v) => setS((x) => ({ ...x, colsLg: v }))} />
          </Row>

          <Row label="Colunas (wide)" hint="xl">
            <Range value={s.colsXl} min={1} max={6} onChange={(v) => setS((x) => ({ ...x, colsXl: v }))} />
            <Num value={s.colsXl} min={1} max={6} onChange={(v) => setS((x) => ({ ...x, colsXl: v }))} />
          </Row>
        </div>

        <div className="rounded-lg border border-border/50 bg-black/30 p-2">
          <div className="mb-1 flex items-center justify-between">
            <div className="text-xs font-extrabold">Produto • Cabeçalho</div>
            <div className="text-[10px] text-foreground/60">mexe em: ProductHeaderCard.tsx</div>
          </div>

          <Row label="Padding" hint="respiro interno">
            <Range value={s.prodPad} min={8} max={48} onChange={(v) => setS((x) => ({ ...x, prodPad: v }))} />
            <Num value={s.prodPad} min={8} max={48} onChange={(v) => setS((x) => ({ ...x, prodPad: v }))} />
          </Row>

          <Row label="Título" hint="tamanho do texto">
            <Range value={s.prodTitle} min={18} max={46} onChange={(v) => setS((x) => ({ ...x, prodTitle: v }))} />
            <Num value={s.prodTitle} min={18} max={46} onChange={(v) => setS((x) => ({ ...x, prodTitle: v }))} />
          </Row>
        </div>

        {pageKey === "carrinho" ? (
          <div className="rounded-lg border border-border/50 bg-black/30 p-2">
            <div className="mb-1 flex items-center justify-between">
              <div className="text-xs font-extrabold">Carrinho • Resumo</div>
              <div className="text-[10px] text-foreground/60">mexe em: CarrinhoBody.tsx</div>
            </div>

            <Row label="Largura do resumo" hint="lado direito">
              <Range value={s.cartSummaryW} min={260} max={520} onChange={(v) => setS((x) => ({ ...x, cartSummaryW: v }))} />
              <Num value={s.cartSummaryW} min={260} max={520} onChange={(v) => setS((x) => ({ ...x, cartSummaryW: v }))} />
            </Row>

            <Row label="Tamanho do TOTAL" hint="texto do preço">
              <Range value={s.cartTotalSize} min={18} max={46} onChange={(v) => setS((x) => ({ ...x, cartTotalSize: v }))} />
              <Num value={s.cartTotalSize} min={18} max={46} onChange={(v) => setS((x) => ({ ...x, cartTotalSize: v }))} />
            </Row>

            <Row label="Botão (altura)" hint="padding Y">
              <Range value={s.cartCtaPy} min={8} max={22} onChange={(v) => setS((x) => ({ ...x, cartCtaPy: v }))} />
              <Num value={s.cartCtaPy} min={8} max={22} onChange={(v) => setS((x) => ({ ...x, cartCtaPy: v }))} />
            </Row>

            <Row label="Botão (largura)" hint="padding X">
              <Range value={s.cartCtaPx} min={10} max={30} onChange={(v) => setS((x) => ({ ...x, cartCtaPx: v }))} />
              <Num value={s.cartCtaPx} min={10} max={30} onChange={(v) => setS((x) => ({ ...x, cartCtaPx: v }))} />
            </Row>

            <Row label="Botão (texto)" hint="tamanho fonte">
              <Range value={s.cartCtaText} min={12} max={20} onChange={(v) => setS((x) => ({ ...x, cartCtaText: v }))} />
              <Num value={s.cartCtaText} min={12} max={20} onChange={(v) => setS((x) => ({ ...x, cartCtaText: v }))} />
            </Row>
          </div>
        ) : null}
      </div>        {pageKey === "produto" ? (
          <div className="rounded-lg border border-border/50 bg-black/30 p-2">
            <div className="mb-1 flex items-center justify-between">
              <div className="text-xs font-extrabold">Produto • Detalhes</div>
              <div className="text-[10px] text-foreground/60">mexe em: page.tsx (galeria/título/botão)</div>
            </div>

            <Row label="Topo da página" hint="espaço acima (pt)">
              <Range value={s.prodTopPad} min={40} max={160} step={2} onChange={(v) => setS((x) => ({ ...x, prodTopPad: v }))} />
              <Num value={s.prodTopPad} min={40} max={160} step={2} onChange={(v) => setS((x) => ({ ...x, prodTopPad: v }))} />
            </Row>

            <Row label="Fim da página" hint="espaço embaixo (pb)">
              <Range value={s.prodBottomPad} min={24} max={140} step={2} onChange={(v) => setS((x) => ({ ...x, prodBottomPad: v }))} />
              <Num value={s.prodBottomPad} min={24} max={140} step={2} onChange={(v) => setS((x) => ({ ...x, prodBottomPad: v }))} />
            </Row>

            <Row label="Espaço entre blocos" hint="gap do grid">
              <Range value={s.prodGridGap} min={8} max={64} onChange={(v) => setS((x) => ({ ...x, prodGridGap: v }))} />
              <Num value={s.prodGridGap} min={8} max={64} onChange={(v) => setS((x) => ({ ...x, prodGridGap: v }))} />
            </Row>

            <Row label="Padding da foto" hint="respiro no card da galeria">
              <Range value={s.prodGalleryPad} min={0} max={40} onChange={(v) => setS((x) => ({ ...x, prodGalleryPad: v }))} />
              <Num value={s.prodGalleryPad} min={0} max={40} onChange={(v) => setS((x) => ({ ...x, prodGalleryPad: v }))} />
            </Row>

            <Row label="Título" hint="tamanho do nome do produto">
              <Range value={s.prodTitleSize} min={22} max={56} onChange={(v) => setS((x) => ({ ...x, prodTitleSize: v }))} />
              <Num value={s.prodTitleSize} min={22} max={56} onChange={(v) => setS((x) => ({ ...x, prodTitleSize: v }))} />
            </Row>

            <Row label="Botão (largura)" hint="padding X">
              <Range value={s.prodCtaPx} min={10} max={34} onChange={(v) => setS((x) => ({ ...x, prodCtaPx: v }))} />
              <Num value={s.prodCtaPx} min={10} max={34} onChange={(v) => setS((x) => ({ ...x, prodCtaPx: v }))} />
            </Row>

            <Row label="Botão (altura)" hint="padding Y">
              <Range value={s.prodCtaPy} min={6} max={20} onChange={(v) => setS((x) => ({ ...x, prodCtaPy: v }))} />
              <Num value={s.prodCtaPy} min={6} max={20} onChange={(v) => setS((x) => ({ ...x, prodCtaPy: v }))} />
            </Row>

            <Row label="Botão (texto)" hint="tamanho da fonte">
              <Range value={s.prodCtaText} min={12} max={20} onChange={(v) => setS((x) => ({ ...x, prodCtaText: v }))} />
              <Num value={s.prodCtaText} min={12} max={20} onChange={(v) => setS((x) => ({ ...x, prodCtaText: v }))} />
            </Row>
          </div>
        ) : null}



      <div className="mt-3 text-[10px] text-foreground/60">
        abre com <span className="font-bold">?tune=1</span> • não salva • é só pra ajustar
      </div>
    </div>
  );
}


