/* ===========================
   FORGE_BG_v1 (fundo do clone)
   =========================== */

:root{
  --forge-bg: #070607;
  --forge-panel: rgba(15,12,12,0.78);
  --forge-panel2: rgba(10,8,8,0.70);
  --forge-border: rgba(255,255,255,0.08);
  --forge-glow: rgba(255, 160, 20, 0.22);
  --forge-glow-strong: rgba(255, 160, 20, 0.35);

  /* combina com o âmbar/dourado da sua marca */
  --forge-accent: #f4b234;
  --forge-accent2: #ff8a1c;
  --forge-text: rgba(255,255,255,0.92);
  --forge-muted: rgba(255,255,255,0.70);

  /* sombras no estilo “premium” */
  --forge-shadow: 0 18px 45px rgba(0,0,0,0.55);
  --forge-shadow2: 0 10px 30px rgba(0,0,0,0.45);
}

body {
  background-image:
    radial-gradient(circle at 18% 12%, rgba(245, 158, 11, 0.16), transparent 46%),
    radial-gradient(circle at 82% 58%, rgba(220, 38, 38, 0.10), transparent 50%);
  background-attachment: fixed;
  background: var(--forge-bg);
  color: var(--forge-text);
}

/* Wrapper global do layout */
.forgeBg_v1{
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* Imagem de fundo (bg-steel) + overlays */
.forgeBg_v1::before{
  content: "";
  position: fixed;
  inset: 0;
  z-index: -3;
  background-image: url("/brand/bg-steel.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  filter: saturate(1.05) contrast(1.05);
  transform: scale(1.02);
}

/* overlay escuro + gradiente (igual clone) */
.forgeBg_v1::after{
  content: "";
  position: fixed;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(1000px 650px at 18% 20%, rgba(255,160,20,0.18), transparent 60%),
    radial-gradient(900px 600px at 80% 30%, rgba(255,120,0,0.12), transparent 62%),
    linear-gradient(180deg, rgba(0,0,0,0.82), rgba(0,0,0,0.55) 35%, rgba(0,0,0,0.82));
  pointer-events: none;
}

/* “vinheta” extra para profundidade */
.forgeVignette_v1{
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(closest-side at 50% 35%, rgba(0,0,0,0.0), rgba(0,0,0,0.65)),
    radial-gradient(closest-side at 20% 80%, rgba(0,0,0,0.0), rgba(0,0,0,0.55)),
    radial-gradient(closest-side at 80% 80%, rgba(0,0,0,0.0), rgba(0,0,0,0.55));
}

/* Cards/containers no estilo do clone */
.forgePanel_v1{
  background: var(--forge-panel);
  border: 1px solid var(--forge-border);
  border-radius: 18px;
  box-shadow: var(--forge-shadow);
  backdrop-filter: blur(10px);
}

.forgePanelSoft_v1{
  background: var(--forge-panel2);
  border: 1px solid var(--forge-border);
  border-radius: 16px;
  box-shadow: var(--forge-shadow2);
  backdrop-filter: blur(10px);
}

.forgeBtn_v1{
  display: inline-flex;
